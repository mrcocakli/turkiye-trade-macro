      "name": "CPI inflation, year on year",
      "unit": "%",
      "category": "Prices",
      "decimals": 1,
      "good_when": "down",
      "formula": "yoy_pct",
      "of": "cpi_index"
    },
    {
      "id": "trade_balance",
      "name": "Goods trade balance",
      "unit": "USD bn",
      "category": "Trade",
